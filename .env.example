# Copie a .env.local (local) o configure en Vercel. Nunca suba valores reales al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor (no use el prefijo NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
REQUIRE_EMAIL_CONFIRMATION=false

# Opcional: asistencia de IA (desactivada por defecto; se activa en /admin/datos)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Solo para scripts/create-test-users.ts en un proyecto de PRUEBAS
APP_ENV=development
ALLOW_TEST_USERS=false
